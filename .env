APP_NAME="Torque"
ENV="development"
DEBUG="true"
SQLITE_PATH="Torque.db"
SECRET_KEY="a-long-random-secret-string"
ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_MINUTES="10080"  # 7 days in minutes
CORS_ALLOW_ORIGINS="http://localhost:3000"

