# .env.prod
APP_ENV=prod
APP_DEBUG=false
API_PREFIX=/v1

# Postgres URL (do not commit real secrets)
# Format: postgresql+psycopg2://user:password@host:5432/dbname
POSTGRES_URL=postgresql+psycopg2://reco_user:strongpassword@prod-db:5432/reco_service

SECRET_KEY="a-long-random-secret-string"
ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_MINUTES="10080"  # 7 days in minutes
CORS_ALLOW_ORIGINS="http://localhost:3000"